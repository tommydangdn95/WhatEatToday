<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup cho Android 12+. Giống backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="dish_images/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="dish_images/" />
    </device-transfer>
</data-extraction-rules>
